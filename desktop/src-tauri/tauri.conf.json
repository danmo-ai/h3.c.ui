{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "H3.UI",
  "version": "0.1.0",
  "identifier": "com.danmo.h3.desktop",
  "build": {
    "beforeDevCommand": "cd ../frontend && npm run dev",
    "beforeBuildCommand": "cd ../frontend && npm run build",
    "devUrl": "http://127.0.0.1:5810/",
    "frontendDist": "../../out/frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "H3.UI",
        "width": 1280,
        "height": 840,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default", "remote-api"]
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "shortDescription": "H3.UI — MiniMax-H3 Metal desktop",
    "longDescription": "H3.UI: native Mac UI for MiniMax-H3 (h3.c / libh3) video generation.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/h3-api",
      "resources/libh3.dylib",
      "resources/ffmpeg",
      "resources/ffprobe"
    ]
  }
}
