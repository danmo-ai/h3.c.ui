{
  "identifier": "remote-api",
  "description": "Allow Tauri IPC when webview talks to local API",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "core:event:default"
  ]
}
